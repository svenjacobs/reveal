{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'schedule:weekly'],
  timezone: 'Europe/Berlin',
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  assignees: ['svenjacobs'],
  semanticCommits: 'enabled',
  semanticCommitScope: 'deps',
  packageRules: [
    {
      // Library dependency updates trigger a patch release and appear in the changelog
      // (release-please), unlike the chore(deps) updates of the demo app, GitHub Actions etc.
      matchManagers: ['gradle'],
      semanticCommitType: 'fix',
    },
    {
      groupName: 'Kotlin',
      matchPackageNames: [
        'org.jetbrains.kotlin*',
        'androidx.compose.compiler*',
        '!org.jetbrains.kotlinx*',
      ],
    },
    {
      // demo-app is a separate Gradle build: keep its updates in their own PRs
      matchFileNames: ['demo-app/**'],
      semanticCommitType: 'chore',
      additionalBranchPrefix: 'demo-app-',
      commitMessageSuffix: 'in demo-app',
    },
  ],
}
